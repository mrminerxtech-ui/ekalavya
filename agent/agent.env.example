# ============================================================
# EKALAVYA FARM AGENT — Configuration
# ============================================================

# Your Railway backend URL — get this from Railway dashboard
# Format: wss://your-app-name.up.railway.app/agent
MMX_SERVER=wss://ekalavya-backend-production.up.railway.app/agent

# Must match AGENT_KEYS in Railway environment variables
AGENT_KEY=ekl-agent-key-change-me

# Farm identity — give each farm a unique name and ID
FARM_NAME=Farm Dubai
FARM_ID=farm-dubai-01

# Your local miner subnet — run ipconfig to find yours
LOCAL_SUBNET=192.168.1.0/24

# CGMiner port (usually 4028)
CGMINER_PORT=4028

# Poll miners every 30 seconds
POLL_MS=30000

# Timeout per IP during scanning (ms)
SCAN_TIMEOUT_MS=2000

# ── RS485 / Modbus RTU for Lanli Hydro (optional) ──────────
# Plug a USB-RS485 adapter into this PC, wire A+/B- to each cabinet
# Find COM port: Device Manager → Ports (COM & LPT)
LANLI_RS485_PORT=COM3
LANLI_BAUD=9600
# Cabinet Modbus slave addresses (comma separated)
LANLI_SLAVE_IDS=1,2,3
# Cabinet names (comma separated, same order as slave IDs)
LANLI_NAMES=MY16-542,1to1-535,1to1-288

# ── HMI Screenshot relay (optional) ──────────────────────
# Set to true if this PC runs the Lanli SCADA HMI software
LANLI_HMI_ENABLED=false
# How often to capture HMI screenshot (seconds)
LANLI_HMI_INTERVAL=10

# ── Sonoff TH16 Local LAN Sensors ────────────────────────
# Comma-separated: IP:deviceId:apikey (deviceId and apikey optional)
# Enable LAN Mode in eWeLink app first, then find the TH16's local IP
# Example (one sensor):
# TH16_SENSORS=192.168.1.50
# Example (multiple sensors):
# TH16_SENSORS=192.168.1.50:100112abc1:myapikey1,192.168.1.51:100112abc2:myapikey2
TH16_SENSORS=

# TH16 by MAC address (recommended — agent finds IP automatically via ARP)
# Find MAC in eWeLink app → device → About → MAC Address
# TH16_MACS=a4:cf:12:ab:cd:ef,a4:cf:12:ab:cd:f0

# TH16 by static IP (alternative)
# TH16_SENSORS=192.168.1.50,192.168.1.51

# ── Auto-Update ────────────────────────────────────────────
# The agent checks this GitHub repo every 10 minutes and
# auto-updates itself + restarts if new code is pushed.
# Leave as-is unless you fork the repo.
UPDATE_REPO=mrminerxtech-ui/ekalavya
UPDATE_BRANCH=main
