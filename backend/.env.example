# ============================================================
# EKALAVYA — Environment Variables
# Set these in Railway dashboard under Variables tab
# ============================================================

# Auto-set by Railway — do NOT set this manually
# PORT=3001

NODE_ENV=production

# SECURITY — change this to a long random string
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars

# Your Cloudflare Pages URL (set after deploying frontend)
FRONTEND_URL=https://ekalavya.pages.dev

# Farm agent keys — comma separated if multiple farms
# Must match AGENT_KEY in each farm's .env
AGENT_KEYS=ekl-agent-key-change-me

# Miner default credentials
MINER_DEFAULT_USER=root
MINER_DEFAULT_PASS=root

# Optional — Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Slack/Discord webhook
ALERT_WEBHOOK_URL=

# eWeLink Sensor Integration (optional)
# Get App ID from dev.ewelink.cc — register as developer
EWELINK_APPID=your_app_id_here
EWELINK_SECRET=your_app_secret_here
EWELINK_EMAIL=your_ewelink_login_email
EWELINK_PASSWORD=your_ewelink_password
EWELINK_REGION=eu
# Regions: eu (Europe), us (Americas), as (Asia), cn (China)

# SCADA Hydro System (Lanli)
SCADA_USERNAME=Wafra
SCADA_PASSWORD=L12345678
SCADA_SITE=Wafra Hydro Site
